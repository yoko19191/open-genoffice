{
  "version": 1,
  "title": "图文数据页",
  "canvas": { "widthPx": 1280, "heightPx": 720 },
  "background": { "artifactId": "11111111-1111-4111-8111-111111111111" },
  "elements": [
    {
      "id": "chart",
      "kind": "chart",
