      "y": 60,
      "w": 500,
      "h": 240,
      "rows": [
        ["指标", "数值"],
        ["收入", "12"]
      ]
    },
    {
      "id": "flow",
      "kind": "smartart",
      "layout": "process",
      "x": 240,
      "y": 430,
      "w": 800,
      "h": 160,
      "items": ["输入", "分析", "结论"]
    }
  ]
